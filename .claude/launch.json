{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "qeerah-dev",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8099"
      ],
      "port": 8099,
      "env": {
        "QEERAH_COOKIE_NON_SECURISE": "1"
      }
    },
    {
      "name": "qeerah-dev-windows",
      "runtimeExecutable": "./venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "8099"
      ],
      "port": 8099,
      "env": {
        "QEERAH_COOKIE_NON_SECURISE": "1",
        "APP_SIGNING_SECRET": "secret-de-dev-local-non-production",
        "ADMIN_EMAIL": "admin-test@example.com",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
